# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The newer names SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY work too.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable / anon key
SUPABASE_SERVICE_ROLE_KEY=            # secret / service_role key — server only, never expose
NEXT_PUBLIC_SITE_URL=http://localhost:3000
